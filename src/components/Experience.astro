---
import { EXPERIENCE_DATA } from "../data/experience";
---
<section id="experiencia" class="py-10 md:py-16">
  <details class="group" open>
    <summary
      class="flex justify-between items-center cursor-pointer select-none mb-6 md:mb-10 hover:opacity-80 transition-opacity"
    >
      <h2
        class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2 sm:gap-3"
      >
        <span class="text-blue-400">01.</span> Experiencia Laboral
      </h2>
      <span
        class="text-zinc-500 transition-transform duration-300 group-open:rotate-180"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 9l-7 7-7-7"></path></svg
        >
      </span>
    </summary>

    <div class="flex flex-col gap-4 sm:gap-5 mt-2">
      {
        EXPERIENCE_DATA.map((exp) => (
          <div class="group/card p-5 sm:p-6 rounded-2xl bg-white/[0.02] border border-white/5 hover:bg-white/[0.04] hover:border-white/10 transition-all duration-300">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 sm:gap-4 mb-3">
              <div>
                <h3 class="text-base sm:text-lg font-bold text-zinc-100">
                  {exp.role}
                </h3>
                <p class="text-emerald-400 text-sm font-medium mt-1">
                  {exp.company}
                </p>
              </div>
              <span class="text-[11px] sm:text-xs font-mono text-zinc-400 bg-white/5 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-full border border-white/5 whitespace-nowrap">
                {exp.date}
              </span>
            </div>
            <p class="text-zinc-400 text-sm leading-relaxed mb-4">
              {exp.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {exp.tags.map((tag) => (
                <span class="text-[10px] sm:text-[11px] font-medium px-2 py-1 rounded bg-white/5 text-zinc-300 border border-white/5">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </details>
</section>
