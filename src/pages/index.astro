---
import Footer from "@/components/Footer.astro";
import Experience from "@/components/Experience.astro";
import HeroSection from "@/components/HeroSection.astro";
import ProjectSection from "@/components/ProjectSection.astro";
import NavSection from "@/components/NavSection.astro";
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Javi Barrientos | Frontend Developer</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Inter", sans-serif;
        background-color: #09090b;
        color: #f4f4f5;
      }
      details > summary {
        list-style: none;
      }
      details > summary::-webkit-details-marker {
        display: none;
      }
    </style>
  </head>
  <body class="antialiased selection:bg-emerald-500/30">
    <div
      class="fixed inset-0 -z-10 h-screen w-screen bg-[#09090b] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/20 via-[#09090b] to-[#09090b] pointer-events-none"
    >
    </div>
    <main
      class="relative px-4 sm:px-6 md:px-12 max-w-5xl mx-auto overflow-x-hidden min-h-screen"
    >
      <NavSection />
      <HeroSection />
      <Experience />
      <ProjectSection />
      <Footer />
    </main>
  </body>
</html>
